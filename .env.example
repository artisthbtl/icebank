APP_NAME=Icebank
APP_ENV=local
# Run 'php artisan key:generate' after copying .env.example to .env
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Settings
# IMPORTANT: DB_HOST must be 'db' to connect to the database service in docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=icebank_db
DB_USERNAME=icebank_user
DB_PASSWORD=secret

# Session, Cache, and Queue Settings
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mailer Settings (REQUIRED FOR REGISTRATION/PASSWORD RESET)
MAIL_MAILER="smtp"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
# Replace with your actual email service credentials (e.g., Gmail App Password)
MAIL_USERNAME=YOUR_EMAIL_ADDRESS_HERE
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
MAIL_FROM_ADDRESS=YOUR_EMAIL_ADDRESS_HERE
MAIL_FROM_NAME="${APP_NAME}"

# JSON Web Token Secret
# Run 'php artisan jwt:secret' after copying .env.example to .env
JWT_SECRET=